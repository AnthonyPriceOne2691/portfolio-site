---
import { getCollection } from "astro:content";

// Заглушка каркаса: доказывает, что коллекция читается и схема применяется.
// Настоящая Home (hero, impact strip, featured, сетка) — поставка MVP, design 4.2.
const projects = (await getCollection("en"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Anton Aspidov — AI Automation Engineer</title>
    <meta
      name="description"
      content="Production AI SaaS plus fully-local voice, web and AR agents. LLMs under contract."
    />
  </head>
  <body>
    <main>
      <h1>Anton Aspidov</h1>
      <p>
        AI Automation / LLM Application Engineer — I put LLMs under contract.
      </p>

      <ul>
        {
          projects.map((p) => (
            <li>
              <strong>{p.data.title}</strong> — {p.data.oneLiner} (
              {p.data.metric})
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
