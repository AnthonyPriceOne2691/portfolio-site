---
/**
 * Обёртка страницы: берёт на себя вызов Base и разрешение заголовков из
 * словаря. Вынесена после того, как DRY-гейт нашёл один и тот же блок
 * «импорт Base + interface Props + деструктуризация + вызов Base» в трёх
 * страницах сразу. Совпадение было каркасным, но лечится оно тем же способом,
 * что и любое другое: общим местом.
 */
import Base from "../layouts/Base.astro";
import { t, type TextKey } from "../lib/text";

interface Props {
  titleKey: TextKey;
  descriptionKey: TextKey;
  titleSuffix?: string;
  width?: "prose" | "wide";
}
const { titleKey, descriptionKey, titleSuffix, width } = Astro.props;
const title = titleSuffix ? `${t(titleKey)} — ${titleSuffix}` : t(titleKey);
---

<Base title={title} description={t(descriptionKey)} width={width}>
  <slot />
</Base>
