---
/**
 * Фрейм демо-видео в карточке проекта (design v0.8 §6.1).
 *
 * ⚠ Съёмки ещё нет — и это не повод откладывать место под неё. Раскладка
 * закладывается сейчас, чтобы появление файла было ПОДСТАНОВКОЙ, а не
 * переделкой карточки. Пустой дыры при этом не возникает (пример B3): без
 * медиа фрейм показывает заглушку, а не битый элемент.
 *
 * Тизер играет ТОЛЬКО под курсором (или при раскрытой карточке). Дизайн §6.1
 * запрещал медиа на Home — запрет был по делу: четыре автоплея на первом экране
 * это вес и батарея. Владелец попросил сначала фрейм, потом воспроизведение;
 * запрет снят не целиком, а заменён на условие. С `preload="none"` это ДЕШЕВЛЕ
 * прежнего автоплея: пока карточку не тронули, с диска не качается ни байта.
 *
 * ⚠ Контролов видео во фрейме нет и не будет: он живёт внутри `<summary>`, а это
 * кнопка — нативные контролы ловили бы клик на себя и одновременно сворачивали
 * карточку. У карточки со своим роликом (`demo`) клик по фрейму РАСКРЫТОЙ
 * карточки открывает ролик в модалке (`scripts/demo-modal.ts`, решение владельца
 * 2026-10-02); свёрнутую он, как и вся шапка, раскрывает. Доступный путь к ролику
 * — ссылка «Watch demo» в раскрытой части: фрейм в шапке фокус не получает.
 *
 * Версии видео по языкам разводятся сами: RU-файл проекта несёт RU-ссылку,
 * EN-файл — EN. Никакой логики выбора здесь нет и не нужно.
 */
interface Props {
  proof: { teaser?: string; poster?: string; video?: string };
  /** id карточки, если у неё свой ролик: в раскрытой карточке фрейм его открывает. */
  demo?: string;
}
const { proof, demo } = Astro.props;
---

<figure class="frame glass" data-demo-open={demo}>
  {
    proof.teaser ? (
      <video
        class="teaser"
        data-poster={proof.poster}
        preload="none"
        muted
        loop
        playsinline
        data-src={proof.teaser}
        data-hover-play
        aria-hidden="true"
      />
    ) : (
      <div
        class="poster"
        style={proof.poster ? `background-image:url(${proof.poster})` : ""}
      />
    )
  }
  {!proof.poster && !proof.teaser && <span class="soon">▶</span>}
  {
    demo && (
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
        </svg>
      </span>
    )
  }
</figure>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const v of document.querySelectorAll<HTMLVideoElement>(
    "video[data-hover-play]",
  )) {
    // Реагирует ВСЯ карточка, а не один фрейм: курсор идёт к заголовку, и
    // требовать попадания в маленькое видео сбоку значило бы, что эффекта
    // почти никто не увидит. Область объявлена разметкой (`ProjectCard`), а не
    // угадана через `closest("details")`: иначе перенос фрейма в другой
    // контейнер тихо отключал бы воспроизведение.
    const scope = v.closest("[data-hover-play-scope]") ?? v;
    // Раскрытая карточка «прикалывает» воспроизведение: её открыли нарочно,
    // и гасить фрейм, когда курсор ушёл на текст кейса, значит отнимать ровно
    // то, за чем открывали.
    const disclosure = scope instanceof HTMLDetailsElement ? scope : null;
    const pinned = () => disclosure?.open === true;

    /*
     * ⚠ Постер — тоже не на старте. `preload="none"` держит только сам ролик,
     * а атрибут `poster` браузер качает сразу: 145 КБ, две трети первой
     * загрузки, хотя на телефоне фрейм ниже первого экрана, — и они делили
     * канал с фото, по которому считается LCP (замер 03.10: LCP 1,79 → 1,51 с).
     * Кадр ставится, когда фрейм подъезжает к экрану; до того фрейм показывает
     * свой градиент, а не дыру (B3), — и без JS тоже.
     */
    const showPoster = () => {
      if (!v.poster && v.dataset.poster) v.poster = v.dataset.poster;
    };
    if ("IntersectionObserver" in window) {
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          showPoster();
          near.disconnect();
        },
        { rootMargin: "300px 0px" },
      );
      near.observe(v);
    } else showPoster();

    /** Файл подставляется в последний момент — до этого `preload="none"` молчит. */
    const play = () => {
      showPoster();
      if (reduced) return;
      // Идёт полное демо в модалке — тизер молчит (флаг ставит `demo-modal.ts`).
      if (scope instanceof HTMLElement && scope.dataset.demoPlaying) return;
      if (!v.src && v.dataset.src) v.src = v.dataset.src;
      // `play()` отвергается сам по себе (политика автовоспроизведения, вкладка
      // в фоне) — это не ошибка, и падать из-за неё нечему.
      void v.play().catch(() => {});
    };

    const stop = () => {
      if (pinned()) return;
      v.pause();
      // Назад на первый кадр: иначе при следующем наведении карточка
      // продолжает с середины и выглядит недосмотренной.
      try {
        v.currentTime = 0;
      } catch {}
    };

    scope.addEventListener("pointerenter", play);
    scope.addEventListener("pointerleave", stop);
    // Клавиатурный фокус равнозначен наведению: иначе эффект существует
    // только для мыши.
    scope.addEventListener("focusin", play);
    scope.addEventListener("focusout", stop);
    // Раскрыли — фрейм заводится сам, свернули — гаснет.
    disclosure?.addEventListener("toggle", () => (pinned() ? play() : stop()));
  }
</script>

<style>
  .frame {
    position: relative;
    margin: 0;
    padding: 0;
    flex: 0 0 auto;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: calc(var(--radius) - 0.2rem);
    border: 1px solid var(--preview-frame-border);
    background: var(--preview-frame-bg);
    box-shadow: var(--preview-frame-shadow);
    /* ⚠ Блюр стекла фрейму не нужен: его целиком закрывает непрозрачный кадр
       или градиент, и размытый фон под ним не виден никому, — а браузер всё
       равно пересчитывал его на каждом кадре движения фона. Класс `glass`
       остаётся (рамка, тени, деградация), снят только блюр. */
    backdrop-filter: none;
  }
  /* Префиксное — отдельным блоком: в одном правиле минификатор считает пару
     дублем и оставляет одно (см. canvas.css). */
  @supports (-webkit-backdrop-filter: blur(1px)) {
    .frame {
      -webkit-backdrop-filter: none;
    }
  }
  /* Значок запуска — только у раскрытой карточки: там клик по фрейму открывает
     ролик, а у свёрнутой лишь раскрывает её, и обещать ролик было бы враньём. */
  :global(details[open]) .frame[data-demo-open] {
    cursor: pointer;
  }
  .play {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .play svg {
    box-sizing: content-box;
    padding: 0.85rem 0.8rem 0.85rem 0.95rem;
    border-radius: 50%;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.35);
    box-shadow: 0 0.4rem 1.4rem rgb(0 0 0 / 0.35);
  }
  :global(details[open]) .play {
    opacity: 1;
  }
  .soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.35rem;
    color: var(--accent);
    opacity: 0.8;
  }
  .frame::before,
  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .frame::before {
    background:
      linear-gradient(
        145deg,
        var(--glass-sheen-1) 0%,
        transparent 30%,
        transparent 66%,
        var(--glass-sheen-2) 100%
      ),
      radial-gradient(
        90% 70% at 50% 0%,
        var(--glass-sheen-top) 0%,
        transparent 72%
      );
  }
  /* ⚠ Вуаль — плавный градиент без краёв. Слой наследует от `.glass::after`
     рамку в 1 px и скругление: на статичном постере их было не разглядеть, а
     поверх тёмного живого тизера они рисовали закруглённую «плашку» на нижних
     42% фрейма — заметил владелец 03.10. */
  .frame::after {
    inset: auto 0 0;
    height: 42%;
    border: 0;
    border-radius: 0;
    background: linear-gradient(180deg, transparent 0%, var(--frame-veil) 100%);
  }
  .teaser,
  .poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background:
      radial-gradient(
        120% 120% at 20% 10%,
        var(--glass-highlight) 0%,
        transparent 52%
      ),
      linear-gradient(
        135deg,
        var(--canvas-2),
        var(--canvas-1) 54%,
        var(--canvas-3)
      );
    background-size: cover;
    background-position: center;
    filter: saturate(1.02) contrast(1.02);
    transform: scale(1.001);
    transition:
      transform 0.32s ease,
      filter 0.32s ease;
  }
</style>
