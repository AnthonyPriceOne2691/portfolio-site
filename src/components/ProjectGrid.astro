---
/** Сетка карточек проектов. Общая для Home и `/projects`: обе страницы рисуют
    одно и то же, и DRY-гейт нашёл это раньше, чем расхождение успело появиться. */
import ProjectCard from "./ProjectCard.astro";
import { publishedProjects } from "../lib/projects";
import type { Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** `wide` — альбомные карточки в одну колонку (Home); `grid` — сетка (/projects). */
  layout?: "wide" | "grid";
}
const { locale, layout = "grid" } = Astro.props;
const projects = await publishedProjects(locale);
---

<ul class:list={["grid", layout]}>
  {
    projects.map((p) => (
      <li>
        <ProjectCard entry={p} locale={locale} wide={layout === "wide"} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  /* ⚠ `:not(.wide)`, а НЕ `.grid.grid`. Прежний селектор был попыткой сказать
     «оба класса», но вариант сетки тоже называется `grid`, и `.grid.grid` — это
     просто `.grid` с удвоенной специфичностью: он матчил и альбомный список,
     разгоняя его в две колонки. Карточка выходила вдвое уже задуманного, а
     сборка при этом была зелёной — вёрстку не судит ни один гейт (§12.6). */
  @media (min-width: 40rem) {
    .grid:not(.wide) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
