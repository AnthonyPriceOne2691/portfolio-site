---
/**
 * Список карточек проектов.
 *
 * Отдельный компонент не ради переиспользования — витрина теперь одна, это
 * главная. Ради границы: запрос к коллекции, порядок и разметка списка — одна
 * ответственность, и `Home` не обязан её знать. Появится вторая витрина —
 * возьмёт готовое, а не скопирует запрос (см. `lib/projects`).
 */
import ProjectCard from "./ProjectCard.astro";
import { publishedProjects } from "../lib/projects";

const projects = await publishedProjects();
---

<ul class="list">
  {
    projects.map((p) => (
      <li>
        <ProjectCard entry={p} />
      </li>
    ))
  }
</ul>

<style>
  /*
   * Одна колонка — решение, а не умолчание: карточка альбомная и несёт метрику,
   * заголовок, описание, стек и фрейм сразу. В двух колонках всё это сжимается
   * до нечитаемого. Двухколоночный вариант ушёл вместе со страницей `/projects`.
   *
   * ⚠ Вёрстку не судит ни один гейт (§12.6). Пока вариантов было два, селектор
   * `.grid.grid` — попытка сказать «оба класса» — тихо матчил не тот из них:
   * альбомный список разгонялся в две колонки, карточка выходила вдвое уже
   * задуманного, а сборка оставалась зелёной. Один вариант — нет и места, где
   * это может повториться.
   */
  .list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
</style>
