---
/** Бейдж статуса (design §4.3). Подложка непрозрачная: на стекле цветной
    текст поверх градиента иначе не добирает 4.5:1. */
import { t } from "../lib/text";

interface Props {
  status: "production" | "local-demo" | "poc";
}
const { status } = Astro.props;
---

<span class:list={["badge", status]}>{t(`status.${status}`)}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--badge-bg);
    border: 1px solid currentColor;
  }
  .production {
    color: var(--status-production);
  }
  .local-demo {
    color: var(--status-local-demo);
  }
  .poc {
    color: var(--status-poc);
  }
</style>
