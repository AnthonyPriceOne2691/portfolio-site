---
/**
 * Навигация (design v0.8 §4.5).
 *
 * ⚠ Меню как такового больше НЕТ — ни выпадающего, ни строкой. Это следствие,
 * а не упрощение ради красоты: страниц проектов не осталось, все кейсы лежат
 * карточками на самой главной, и список названий в шапке дублировал бы то, что
 * и так на экране. Критерий §4.6 («пятый проект появляется сам, без правки
 * `.astro`») держится там же, где и жил, — список карточек генерируется из
 * коллекции.
 *
 * ⚠ «Обо мне» остаётся ПРЯМОЙ ссылкой, а не уезжает вместе с меню: это
 * отдельная страница, и без ссылки в шапке на неё нельзя было бы попасть
 * вообще ниоткуда.
 *
 * Ссылка на проект — якорь `/#slug`: он раскрывает карточку, а не просто
 * доматывает до свёрнутой строки (обработчик живёт в `ProjectCard`). Такие
 * ссылки приходят снаружи — из резюме, письма, чата, — поэтому поведение
 * должно работать и без меню.
 */
import { link, pathForLocale, useTranslations, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const here = Astro.url.pathname;
const about = link("/about/", locale);
const other: Locale = locale === "ru" ? "en" : "ru";
---

<header class="nav glass">
  <a class="brand" href={link("/", locale)} aria-label={t("nav.home")}
    >AA<span>.</span></a
  >

  <a
    class="about"
    href={about}
    aria-current={here === about ? "page" : undefined}
  >
    {t("nav.about")}
  </a>

  <div class="actions">
    <button
      class="theme"
      type="button"
      data-theme-toggle
      data-label-light={t("theme.light")}
      data-label-dark={t("theme.dark")}
      aria-label={t("theme.dark")}
      title={t("theme.dark")}
    >
      <span class="theme-sun" aria-hidden="true">☼</span>
      <span class="theme-moon" aria-hidden="true">◐</span>
    </button>

    <a
      class="lang"
      href={pathForLocale(here, other)}
      hreflang={other}
      lang={other}
    >
      {other.toUpperCase()}
    </a>
  </div>
</header>

<script>
  /*
   * Перенос якоря в другой язык.
   *
   * ⚠ Хэш живёт ТОЛЬКО в браузере: до сервера он не доходит, и на статике
   * ссылка языка собирается без него. Из-за этого переключение языка с
   * раскрытой карточки выбрасывало в начало другой главной — пользователь
   * терял ровно то место, ради которого туда шёл.
   *
   * Slug'и у языковых пар одинаковые — это не надежда, а инвариант, который
   * держит `assertLanguagePairs` в `content.config.ts`: файл без пары ВАЛИТ
   * сборку. Значит `#linkbuilder` существует на обоих языках по построению.
   *
   * База берётся один раз из серверного `href`, иначе повторные переключения
   * склеивали бы хэши друг с другом.
   */
  for (const lang of document.querySelectorAll<HTMLAnchorElement>("a.lang")) {
    const base = lang.getAttribute("href") ?? "";
    const carryHash = () => {
      lang.href = `${base}${location.hash}`;
    };
    carryHash();
    window.addEventListener("hashchange", carryHash);
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-h);
    padding: 0.5rem clamp(0.75rem, 4vw, 2rem);
    border-radius: 0;
    border-width: 0 0 1px;
  }
  .brand {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--text);
  }
  .brand span {
    color: var(--accent);
  }
  /* Ссылка «Обо мне» занимает место бывшего меню и отжимает кнопки вправо. */
  .about {
    margin-inline-start: auto;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    transition:
      background-color 0.24s ease,
      color 0.24s ease;
  }
  .about:hover,
  .about:focus-visible,
  .about[aria-current="page"] {
    background: var(--control-active-bg);
    color: var(--accent);
  }
  .theme,
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 999px;
    /* ⚠ Никакого `transform` на hover. Обе кнопки живут в ЛИПКОЙ шапке и стоят
       вплотную: сдвиг на пиксель под уже подъехавшим курсором читается как
       дёрганье, а не как отклик, и на границе кнопки успевает зациклиться
       (ушёл — вернулся — ушёл). Отклик даёт заливка: она так же заметна, но
       не двигает ни саму кнопку, ни соседнюю. */
    transition:
      background-color 0.24s ease,
      border-color 0.24s ease,
      color 0.24s ease;
  }
  .theme {
    position: relative;
    border: 1px solid var(--control-border);
    background: var(--control-bg-quiet);
    color: var(--text);
    padding: 0;
    cursor: pointer;
    overflow: hidden;
  }
  .theme:hover,
  .theme:focus-visible,
  .lang:hover,
  .lang:focus-visible {
    background: var(--control-bg);
  }
  .theme:hover,
  .theme:focus-visible {
    border-color: var(--surface-border-strong);
  }
  .theme-sun,
  .theme-moon {
    grid-area: 1 / 1;
    transition:
      opacity 0.24s ease,
      transform 0.24s ease;
  }
  .theme {
    display: inline-grid;
  }
  .theme[data-theme-current="light"] .theme-sun,
  .theme[data-theme-current="dark"] .theme-moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  .theme[data-theme-current="light"] .theme-moon,
  .theme[data-theme-current="dark"] .theme-sun {
    opacity: 0;
    transform: scale(0.75) rotate(-18deg);
  }
  .lang {
    color: var(--accent);
    padding: 0.4rem 0.8rem;
  }
</style>
