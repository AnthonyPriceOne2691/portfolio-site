---
/**
 * Навигация (design v0.8 §4.5).
 *
 * ⚠ Меню как такового больше НЕТ — ни выпадающего, ни строкой. Это следствие,
 * а не упрощение ради красоты: страниц проектов не осталось, все кейсы лежат
 * карточками на самой главной, и список названий в шапке дублировал бы то, что
 * и так на экране. Критерий §4.6 («пятый проект появляется сам, без правки
 * `.astro`») держится там же, где и жил, — список карточек генерируется из
 * коллекции.
 *
 * ⚠ «Обо мне» остаётся ПРЯМОЙ ссылкой, а не уезжает вместе с меню: это
 * отдельная страница, и без ссылки в шапке на неё нельзя было бы попасть
 * вообще ниоткуда.
 *
 * Ссылка на проект — якорь `/#slug`: он раскрывает карточку, а не просто
 * доматывает до свёрнутой строки (обработчик живёт в `ProjectCard`). Такие
 * ссылки приходят снаружи — из резюме, письма, чата, — поэтому поведение
 * должно работать и без меню.
 *
 * ⚠ Переключателя языка здесь больше нет: сайт одноязычный с 2026-09-22.
 * Вместе с ним ушёл скрипт переноса хэша между языками — он существовал
 * только затем, чтобы смена языка с раскрытой карточки не выбрасывала в
 * начало другой главной.
 */
import HandNote from "./HandNote.astro";
import { t } from "../lib/text";

const here = Astro.url.pathname;
const about = "/about/";
// Резюме лежит на About, но из шапки этого не видно: пункт называется «About»,
// а не «CV». Стрелка под ним — везде, кроме самой About: там она указывала бы
// на ссылку, по которой человек уже пришёл.
const cvHint = here !== about;
---

<header class="nav glass">
  <a class="brand" href="/" aria-label={t("nav.home")}>AA<span>.</span></a>

  <a
    class="about"
    href={about}
    aria-current={here === about ? "page" : undefined}
    aria-describedby={cvHint ? "cv-hint-note" : undefined}
  >
    {t("nav.about")}
  </a>

  <div class="actions">
    <button
      class="theme"
      type="button"
      data-theme-toggle
      data-label-light={t("theme.light")}
      data-label-dark={t("theme.dark")}
      aria-label={t("theme.dark")}
      title={t("theme.dark")}
    >
      <span class="theme-sun" aria-hidden="true">☼</span>
      <span class="theme-moon" aria-hidden="true">◐</span>
    </button>
  </div>
</header>

{
  cvHint && (
    <div class="cv-hint">
      <HandNote
        id="cv-hint-note"
        text={t("nav.cvHint")}
        viewBox="0 0 96 36"
        stem="M91 29C93 12 40 16 24 5"
        tip="M26.2 11.1 24 5h6.5"
      />
    </div>
  )
}

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
    min-height: var(--nav-h);
    padding: 0.5rem var(--nav-pad-x);
    border-radius: 0;
    border-width: 0 0 1px;
  }
  .brand {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--text);
  }
  .brand span {
    color: var(--accent);
  }
  /* Ссылка «Обо мне» занимает место бывшего меню и отжимает кнопки вправо. */
  .about {
    margin-inline-start: auto;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    transition:
      background-color 0.24s ease,
      color 0.24s ease;
  }
  .about:hover,
  .about:focus-visible,
  .about[aria-current="page"] {
    background: var(--control-active-bg);
    color: var(--accent);
  }
  .theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--nav-control);
    min-height: var(--nav-control);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 999px;
    /* ⚠ Никакого `transform` на hover. Кнопка живёт в ЛИПКОЙ шапке: сдвиг на
       пиксель под уже подъехавшим курсором читается как дёрганье, а не как
       отклик, и на границе кнопки успевает зациклиться (ушёл — вернулся —
       ушёл). Отклик даёт заливка: она так же заметна, но кнопку не двигает. */
    transition:
      background-color 0.24s ease,
      border-color 0.24s ease,
      color 0.24s ease;
  }
  .theme {
    position: relative;
    border: 1px solid var(--control-border);
    background: var(--control-bg-quiet);
    color: var(--text);
    padding: 0;
    cursor: pointer;
    overflow: hidden;
  }
  .theme:hover,
  .theme:focus-visible {
    background: var(--control-bg);
  }
  .theme:hover,
  .theme:focus-visible {
    border-color: var(--surface-border-strong);
  }
  .theme-sun,
  .theme-moon {
    grid-area: 1 / 1;
    transition:
      opacity 0.24s ease,
      transform 0.24s ease;
  }
  .theme {
    display: inline-grid;
  }
  .theme[data-theme-current="light"] .theme-sun,
  .theme[data-theme-current="dark"] .theme-moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  .theme[data-theme-current="light"] .theme-moon,
  .theme[data-theme-current="dark"] .theme-sun {
    opacity: 0;
    transform: scale(0.75) rotate(-18deg);
  }

  /*
   * Стрелка «my CV is here» под пунктом About.
   *
   * ⚠ Живёт ВНЕ шапки — блоком нулевой высоты сразу под ней, — и это решение,
   * а не случайность. Шапка липкая: положенная внутрь, стрелка висела бы над
   * карточками при любой прокрутке. Отсюда она уезжает вместе со страницей и
   * уходит под стекло шапки, как любой контент. Плата — целиться приходится по
   * числам шапки (`--nav-*` в tokens.css), а не по самому пункту; попадание
   * острия в About стережёт `tests/layout.test.mjs`.
   */
  .cv-hint {
    position: relative;
    /* Над героем, но под шапкой — у неё 10. */
    z-index: 2;
    height: 0;
  }
  .cv-hint :global(.hand-arrow) {
    position: absolute;
    top: -2px;
    /* Линия выходит из конца подписи — над «here» — поднимается и уходит
       влево, как стрелка у кнопки на /about/, только вверх. Правый край
       рисунка — у правого края подписи; острие ложится под правую часть
       About и смотрит вверх-влево, на само слово. */
    right: var(--nav-pad-x);
    width: 6rem;
    height: 2.25rem;
  }
  .cv-hint :global(.hand-text) {
    position: absolute;
    top: 1.85rem;
    /* Прижата к правому краю АБСОЛЮТНО, а не `text-align`: строка, не
       влезшая в блок, переливается вправо при любом выравнивании — и на узком
       экране это был бы горизонтальный скролл (пример B7). */
    right: var(--nav-pad-x);
  }
</style>
