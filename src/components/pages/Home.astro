---
/** Главная. В этом слайсе — вход в витрину; полноценный hero с фото, тремя
    цифрами и секцией How I work приходит слайсом 2 (design v0.8 §4.2). */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

import PageShell from "../PageShell.astro";
import ProjectGrid from "../ProjectGrid.astro";
import { useTranslations, type Locale } from "../../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Фото подставляется САМО, как только файл появится в `public/`.
 *
 * ⚠ Ключевое здесь — условие, а не путь. Поставить `<img src="/photo.jpg">`
 * безусловно значило бы получить иконку битой картинки у всех, пока файла нет,
 * причём владелец её не увидел бы: у него файл есть. Это тот же запрет на
 * «пустую дыру», что и у видеофрейма (пример B3). Пока файла нет — остаётся
 * стеклянный кружок, который держит раскладку, и появление фотографии её не
 * перекроит.
 *
 * Расширения перебираются в фиксированном порядке, чтобы результат сборки не
 * зависел от того, что владелец положил первым.
 */
const inPublic = (f: string) =>
  existsSync(fileURLToPath(new URL(`../../../public/${f}`, import.meta.url)));

const PHOTO_FILES = ["photo.jpg", "photo.jpeg", "photo.png", "photo.webp"];
const photo = PHOTO_FILES.find(inPublic);

/*
 * Кружок умеет быть видео «о себе» — и тоже САМ, по появлению файла.
 *
 * ⚠ Постер обязателен: видео подставляется ТОЛЬКО поверх фотографии. Без
 * постера круг до первого клика — чёрная дыра, а это ровно тот запрет, ради
 * которого выше стоит заглушка. Поэтому `intro` ищется лишь тогда, когда фото
 * уже нашлось, и фотография остаётся первым кадром.
 *
 * ⚠ Играет по КЛИКУ, а не по наведению, как тизеры в карточках. Говорящая
 * голова без звука выглядит сломанной, а звук по наведению браузеры не дадут
 * и не должны. Клик заодно снимает вопрос `prefers-reduced-motion`: это
 * осознанное действие зрителя, а не движение, которое ему навязали.
 *
 * Язык выбирается файлом, а не кодом: `intro-en.mp4` ложится только на
 * английскую страницу, `intro.mp4` — на обе. Так владелец может снять одну
 * английскую версию (она полезнее: русскоязычный зритель английскую посмотрит,
 * англоязычный русскую — нет) и назвать её `intro.mp4`, не трогая исходников.
 */
const intro = photo
  ? [`intro-${locale}.mp4`, "intro.mp4"].find(inPublic)
  : undefined;
---

<PageShell
  locale={locale}
  titleKey="home.title"
  descriptionKey="home.description"
  width="wide"
>
  <section class="hero">
    <!-- Место под фото зарезервировано (design v0.8 §4.2): подстановка файла
         не должна перекраивать раскладку. Размеры у `<img>` проставлены явно —
         без них браузер не знает высоту до загрузки и первый экран дёргается
         ровно там, где на него впервые смотрят. -->
    {
      intro && photo ? (
        <button
          class="intro"
          type="button"
          aria-pressed="false"
          aria-label={t("home.introPlay")}
          data-intro
        >
          <video
            class="photo"
            src={`/${intro}`}
            poster={`/${photo}`}
            preload="none"
            playsinline
            width="200"
            height="200"
          />
          {/* Значок — единственный контрол. Нативную панель сюда ставить
              нельзя: `border-radius: 50%` срежет ей низ, и выглядеть это
              будет поломкой, а не круглым плеером. Пауза — повторный клик. */}
          <span class="badge" aria-hidden="true">
            ▶
          </span>
        </button>
      ) : photo ? (
        <img
          class="photo"
          src={`/${photo}`}
          alt={t("home.photoAlt")}
          width="200"
          height="200"
        />
      ) : (
        <div class="photo glass" aria-hidden="true" />
      )
    }
    <div>
      <h1>Anton Aspidov</h1>
      <p class="role">{t("home.role")}</p>
      <p class="pitch">{t("home.pitch")}</p>
      <p class="status">{t("home.status")}</p>
    </div>
  </section>

  <section class="projects">
    <div class="section-head">
      <h2>{t("projects.title")}</h2>
      <p>{t("home.projectsHint")}</p>
    </div>
    <ProjectGrid locale={locale} />
  </section>
</PageShell>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-intro]");
  const video = btn?.querySelector("video");

  if (btn && video) {
    btn.addEventListener("click", () => {
      // `play()` отвергается сам по себе (вкладка в фоне, политика
      // автовоспроизведения) — это не ошибка, и падать из-за неё нечему.
      if (video.paused) void video.play().catch(() => {});
      else video.pause();
    });

    const state = () => btn.setAttribute("aria-pressed", String(!video.paused));
    video.addEventListener("play", state);
    video.addEventListener("pause", state);

    // ⚠ После `ended` в круге застывает ПОСЛЕДНИЙ кадр — случайная гримаса
    // вместо портрета, и так до перезагрузки страницы. `load()` возвращает
    // постер: досмотревший видит то же фото, что и не начинавший.
    video.addEventListener("ended", () => {
      video.load();
      state();
    });
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .photo {
    aspect-ratio: 1;
    width: min(200px, 60vw);
    height: auto;
    border-radius: 50%;
    /* `cover` обязателен: портрет почти никогда не идеально квадратный, и без
       него неквадратный файл сплющило бы в кружке. */
    object-fit: cover;
  }
  /* Оправа только у настоящего медиа: заглушке её даёт класс `glass`. */
  img.photo,
  video.photo {
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
  }
  /* Кнопка не рисуется — рисуется кружок внутри неё. */
  .intro {
    position: relative;
    display: block;
    width: min(200px, 60vw);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    /* `line-height` у кнопки добавил бы полосу под видео и сместил бы круг
       относительно текста справа. */
    line-height: 0;
  }
  .intro:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .badge {
    position: absolute;
    right: 6%;
    bottom: 6%;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--canvas-1);
    box-shadow: var(--glass-shadow);
    color: var(--accent);
    font-size: 0.9rem;
    line-height: 1;
    transition: opacity 0.2s ease;
  }
  /* Играет — значок уходит: он приглашение, а не индикатор. */
  .intro[aria-pressed="true"] .badge {
    opacity: 0;
  }
  .intro:hover .badge {
    transform: scale(1.06);
  }
  .role {
    font-weight: 600;
    color: var(--text-muted);
    margin-top: -0.25rem;
  }
  .pitch {
    font-size: 1.1rem;
  }
  .status {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .projects {
    display: grid;
    /* Воздух между подсказкой и первой карточкой: подсказка относится ко всему
       списку, и без паузы она читается как подпись к первой из них. */
    gap: 1.75rem;
  }
  .section-head {
    display: grid;
    gap: 0.25rem;
  }
  /* ⚠ Без `max-width`. Подсказка короткая и обязана лечь в ОДНУ строку: в две
     она выглядит абзацем и перетягивает внимание с карточек, ради которых
     написана. Ограничение в 52ch ломало её пополам на любом широком экране.
     На узком перенос всё равно случится — и это правильно, там строки нет. */
  .section-head p {
    margin: 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
  }
</style>
