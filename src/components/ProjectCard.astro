---
/**
 * Карточка проекта (design v0.9 §4.3). Одна ключевая метрика, не список.
 *
 * Два режима. `wide` — альбомная, во всю ширину: метрика уходит влево крупным
 * блоком, текст вправо. Так карточка читается как строка таблицы результатов,
 * а не как плитка, и на Home это уместнее — там их всего три и они несут
 * главный аргумент. Обычная сетка остаётся на `/projects`, где карточек может
 * стать много.
 */
import type { CollectionEntry } from "astro:content";
import StatusBadge from "./StatusBadge.astro";
import VideoFrame from "./VideoFrame.astro";
import { link, type Locale } from "../i18n/ui";

interface Props {
  entry: CollectionEntry<"ru"> | CollectionEntry<"en">;
  locale: Locale;
  wide?: boolean;
}
const { entry, locale, wide = false } = Astro.props;
const d = entry.data;
---

<a
  class:list={["card", "glass", { wide }]}
  href={link(`/projects/${entry.id}/`, locale)}
>
  <span class="body">
    <span class="lead">
      <span class="metric">{d.metric}</span>
      <StatusBadge status={d.status} locale={locale} />
    </span>
    <span class="title">{d.title}</span>
    <span class="one">{d.oneLiner}</span>
    <span class="stack">{d.stack.slice(0, 5).join(" · ")}</span>
  </span>
  {
    wide && (
      <span class="media">
        <VideoFrame
          proof={d.proof}
          title={d.title}
          locale={locale}
          variant="card"
        />
      </span>
    )
  }
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.15rem;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.18s ease;
  }
  .card:hover {
    transform: translateY(-2px);
  }
  .lead {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .metric {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .one,
  .stack {
    color: var(--text-muted);
  }
  .stack {
    font-size: 0.85rem;
    margin-top: auto;
  }

  /* Альбомная раскладка — только когда есть куда её разложить. На узком
     экране карточка остаётся колонкой: горизонтальная на 360 px дала бы
     горизонтальный скролл, а его сторожит пример B7. */
  /* Фрейм под видео. На узком экране он идёт НАД текстом во всю ширину:
     класть его сбоку на 360 px значило бы получить горизонтальный скролл,
     который сторожит пример B7. */
  .media {
    display: block;
    width: 100%;
    order: -1;
  }

  @media (min-width: 46rem) {
    .card.wide {
      flex-direction: row;
      align-items: stretch;
      gap: 1.75rem;
      padding: 1.5rem 1.6rem;
      /* Выше по вертикали — просьба владельца 15.08. Не фиксированная высота:
         `min-height` растёт под длинный one-liner и не режет текст. */
      min-height: 13rem;
    }
    .card.wide .body {
      flex: 1 1 auto;
      justify-content: center;
      gap: 0.5rem;
    }
    .card.wide .metric {
      font-size: 1.6rem;
      line-height: 1.1;
    }
    .card.wide .stack {
      margin-top: 0.4rem;
    }
    .card.wide .media {
      order: 0;
      flex: 0 0 auto;
      width: clamp(13rem, 26%, 19rem);
      display: flex;
      align-items: center;
    }
  }
</style>
