---
/**
 * Карточка проекта на главной (design v0.9 §4.3). Одна ключевая метрика, не список.
 *
 * Карточка РАСКРЫВАЕТСЯ: свёрнутая — это витринная строка (метрика, заголовок,
 * одна фраза, фрейм сбоку), раскрытая — полный кейс, контракт и пруфы. Отдельной
 * страницы-списка проектов нет, витрина — это главная, поэтому «подробнее»
 * должно открываться здесь же, а не уводить со страницы.
 *
 * ⚠ Взято `<details>`, а не кнопка с `aria-expanded`, и это не вкус: раскрытие
 * работает БЕЗ JS — нативно, с клавиатуры, с правильной ролью для скринридера.
 * JS ниже добавляет только анимацию; не загрузился — карточка всё равно
 * открывается, просто мгновенно. Тот же приём, что у меню в шапке.
 *
 * ⚠ Фрейм живёт в `<summary>`, и контролов видео в нём нет: `<summary>` — это
 * кнопка, нативные контролы ловили бы клик на себя и сворачивали карточку.
 * Полное демо открывается В МОДАЛКЕ (решение владельца 2026-10-02: «не
 * превращать карточку в простыню») — кликом по фрейму раскрытой карточки или по
 * «Watch demo». Сам ролик лежит здесь же, в `<template>`: модалка одна на
 * страницу (`DemoModal`) и берёт его отсюда.
 */
import { render, type CollectionEntry } from "astro:content";
import ProofLinks from "./ProofLinks.astro";
import StatusBadge from "./StatusBadge.astro";
import VideoFrame from "./VideoFrame.astro";
import { t } from "../lib/text";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/*
 * Плеер встраивается только для СВОЕГО файла.
 *
 * Внешняя ссылка (YouTube, Vimeo) в `<video>` не играет — там нужен их плеер в
 * `<iframe>`, а это чужой скрипт, куки и вес на каждой карточке. Для неё
 * остаётся обычная ссылка в пруфах: поведение выбирается по содержимому
 * frontmatter, а не отдельным флагом, который забудут переставить.
 */
const OWN_VIDEO = /^\/.+\.(mp4|webm|ogv)$/i;
const demo =
  d.proof.video && OWN_VIDEO.test(d.proof.video) ? d.proof.video : null;
/** Дорожки субтитров: английская — язык голоса, включена сразу; русская — по выбору в CC. */
const CAPTIONS = [
  { lang: "en", label: "English" },
  { lang: "ru", label: "Русский" },
] as const;
// Ссылка «Watch demo» остаётся и у своего ролика: со скриптом она открывает
// модалку, без него — сам файл, а с клавиатуры это единственный путь к ролику
// (фрейм в шапке фокус не получает).
---

<!-- `data-hover-play-scope` — область, наведение на которую оживляет тизер во
     фрейме (см. `VideoFrame`). Объявлена здесь, потому что «карточка» — это
     понятие ЭТОГО компонента: фрейм про неё знать не должен. --><!-- `name` делает карточки взаимоисключающими СИЛАМИ БРАУЗЕРА — это запасной
     путь для случая, когда скрипт не загрузился: аккордеон всё равно
     аккордеон. Когда JS есть, он этот атрибут снимает (см. скрипт). -->
<details class="card glass" id={entry.id} name="projects" data-hover-play-scope>
  <summary class="head">
    <span class="body">
      <span class="lead">
        <span class="metric">{d.metric}</span>
        <StatusBadge status={d.status} />
      </span>
      <span class="title">{d.title}</span>
      <span class="one">{d.oneLiner}</span>
      <span class="stack">{d.stack.slice(0, 5).join(" · ")}</span>
    </span>
    <span class="media">
      <VideoFrame proof={d.proof} demo={demo ? entry.id : undefined} />
    </span>
  </summary>

  <div class="panel">
    <div class="panel-inner">
      {
        /* Пруфы — ПЕРВОЙ строкой, а не в конце кейса: раскрывший карточку
          должен сразу увидеть, что бриф можно унести с собой, а не
          дочитывать до низа, чтобы узнать об этом. */
      }
      <ProofLinks proof={d.proof} />

      {
        /* Ролик для модалки. `<template>` ничего не грузит, пока его не
          клонировали; субтитры — дорожками, а не в кадре: английская включена
          сразу (`default`), русская выбирается в меню плеера. */
        demo && (
          <template id={`demo-${entry.id}`}>
            <video
              src={demo}
              poster={d.proof.poster}
              controls
              preload="metadata"
              playsinline
            >
              {CAPTIONS.map(
                (c) =>
                  d.proof.captions?.[c.lang] && (
                    <track
                      kind="subtitles"
                      src={d.proof.captions[c.lang]}
                      srclang={c.lang}
                      label={c.label}
                      default={c.lang === "en"}
                    />
                  ),
              )}
            </video>
          </template>
        )
      }

      <div class="prose"><Content /></div>

      <section class="contract">
        <h3>[✓] {t("project.contract")}</h3>
        <p>{d.contract}</p>
      </section>

      <p class="full-stack">
        <span class="label">{t("project.stack")}:</span>
        {d.stack.join(" · ")}
      </p>
    </div>
  </div>
</details>

<script>
  import "../scripts/card-accordion";
</script>

<style>
  /* Переход по якорю ставит состояние мгновенно — см. разбор в скрипте.
     Класс живёт ровно один кадр. */
  .card.instant {
    transition: none;
  }
  .card {
    /* Якорь из меню не должен приземлять карточку ПОД липкую шапку; на телефоне
       шапка не липкая (Nav.astro) — хватит поля. */
    scroll-margin-top: 1rem;
    padding: 1.25rem;
    color: var(--text);
    /* Поле и отступ едут ОДНИМ переходом, иначе на выходе за поля (ниже)
       содержимое успевало бы сдвинуться, пока одно догоняет другое. */
    transition:
      margin 0.42s cubic-bezier(0.22, 0.61, 0.36, 1),
      padding 0.42s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.28s ease,
      border-color 0.28s ease;
  }
  @media (hover: hover) and (min-width: 46rem) {
    .card {
      scroll-margin-top: calc(var(--nav-h) + 1rem);
    }
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    cursor: pointer;
    /* Штатный треугольник `<details>` убирается в двух местах: спецификация
       и WebKit расходятся в том, чем он рисуется. */
    list-style: none;
    /* Штатная подсветка касания на iOS — тёмная скруглённая плашка поверх
       всего, что нажато. Здесь нажата шапка в полкарточки, и плашка
       накрывала её целиком. Отклик на касание даёт само раскрытие. */
    -webkit-tap-highlight-color: transparent;
  }
  .head::-webkit-details-marker {
    display: none;
  }
  /* ⚠ Подъём карточки — отклик на курсор и на КЛАВИАТУРНЫЙ фокус, и только
     там, где курсор есть. На телефоне `:hover` залипает после касания, а
     `:focus-within` держится, пока фокус в карточке, — касание ставит его на
     `summary`: карточка оставалась «поднятой», фрейм — сдвинутым. Клавиатуру
     ловит `:has(:focus-visible)`: фокус от касания и мыши его не включает.
     Кольцо фокуса из global.css от этого не зависит и видно везде. */
  @media (hover: hover) {
    .card:hover,
    .card:has(:focus-visible) {
      border-color: var(--surface-border-strong);
      box-shadow: var(--lift-shadow), var(--glass-inner);
    }
  }
  .lead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .metric {
    font-weight: 800;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }
  .title {
    min-width: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .one,
  .stack {
    color: var(--text-muted);
  }
  .one {
    line-height: 1.5;
  }
  .stack {
    font-size: 0.85rem;
    margin-top: auto;
  }

  /* Фрейм под видео. На узком экране он идёт НАД текстом во всю ширину:
     класть его сбоку на 360 px значило бы получить горизонтальный скролл,
     который сторожит пример B7. */
  .media {
    display: block;
    width: 100%;
    order: -1;
  }
  .media :global(.frame) {
    transition:
      transform 0.32s ease,
      box-shadow 0.32s ease,
      border-color 0.32s ease;
  }
  @media (hover: hover) {
    .card:hover .media :global(.frame),
    .card:has(:focus-visible) .media :global(.frame) {
      transform: translate3d(4px, -2px, 0) scale(1.015);
      box-shadow: var(--lift-shadow-media), var(--glass-inner);
    }
  }

  /* --- раскрытая часть --- */
  /* `overflow: hidden` здесь не косметика: по нему анимируется высота, и без
     него содержимое вылезало бы поверх соседней карточки во время движения. */
  .panel {
    overflow: hidden;
  }
  .panel-inner {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--surface-border-soft);
  }
  .prose :global(p) {
    margin: 0 0 0.75rem;
  }
  .prose :global(ul) {
    margin: 0 0 0.75rem;
    padding-inline-start: 1.1rem;
  }
  .prose :global(li) {
    margin-bottom: 0.3rem;
  }
  .contract {
    margin: 1.25rem 0;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--surface-soft);
    border: 1px solid var(--surface-border-soft);
  }
  .contract h3 {
    font-size: 1rem;
    margin: 0 0 0.3rem;
  }
  .contract p {
    margin: 0;
    color: var(--text-muted);
  }
  .full-stack {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .full-stack .label {
    font-weight: 600;
  }
  .more {
    margin: 0.75rem 0 0;
    font-weight: 600;
  }

  /* Альбомная раскладка — только когда есть куда её разложить. Ниже 46rem
     карточка остаётся колонкой: горизонтальная на 360 px дала бы
     горизонтальный скролл, а его сторожит пример B7. */
  @media (min-width: 46rem) {
    .head {
      flex-direction: row;
      align-items: stretch;
      gap: 1.9rem;
    }
    .card {
      --pad-inline: 1.7rem;
      padding: 1.55rem var(--pad-inline);
    }
    .head .body {
      flex: 1 1 auto;
      justify-content: center;
      gap: 0.6rem;
      /* Высота живёт ЗДЕСЬ, а не на карточке: на `<details>` она прибавилась бы
         к раскрытой панели и оставляла бы под ней пустоту. */
      min-height: 11.5rem;
    }
    .metric {
      font-size: clamp(1.9rem, 2.3vw, 2.5rem);
      max-width: 17ch;
    }
    .title {
      font-size: 1.3rem;
    }
    .stack {
      margin-top: 0.5rem;
    }
    .media {
      order: 0;
      flex: 0 0 auto;
      width: clamp(14.5rem, 28%, 20.5rem);
      display: flex;
      align-items: center;
    }
    /* ⚠ При раскрытии фрейм НЕ растёт. Раньше рос (28% → 38% шапки) — и
       отнимал ширину у текста: тот перекладывался на каждом кадре анимации,
       фраза прыгала со строки на строку, метрика съезжала вниз. Владелец
       назвал это «текст пляшет». Крупное видео — дело модалки демо: ролик
       открывается поверх страницы по клику на фрейм. Сторож — тест «текст
       карточки не пляшет» в `tests/layout.test.mjs`. */
  }

  /*
   * ⚠ Выход за поля колонки — только здесь и не раньше.
   *
   * Карточка и так во всю ширину `--measure-wide` (68rem), «шире» ей расти
   * некуда: любое расширение — это выход за контейнер, то есть кандидат в
   * горизонтальный скролл (пример B7). Порог 76rem подобран так, чтобы запас
   * был гарантирован: 68rem колонки плюс 2×1.5rem выхода = 71rem, и до 76rem
   * остаётся ещё пять на полосу прокрутки и поля окна. Ниже порога карточка
   * при раскрытии просто не двигается по горизонтали — и это правильнее, чем
   * отъехать за край экрана.
   *
   * ⚠ За поля выходит ПОВЕРХНОСТЬ карточки, а не её содержимое: отступ растёт
   * ровно на столько же, на сколько уходит поле, и текст стоит на месте.
   * Одним отрицательным полем содержимое уезжало на 1.5rem влево и
   * перекладывалось по новой ширине — половина той «пляски», что нашёл
   * владелец 26.09.
   */
  @media (min-width: 76rem) {
    .card[open] {
      --out: 1.5rem;
      margin-inline: calc(-1 * var(--out));
      padding-inline: calc(var(--pad-inline) + var(--out));
    }
  }
</style>
